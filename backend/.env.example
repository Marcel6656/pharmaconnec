# Base de données SQLite locale créée au démarrage (ou PostgreSQL/Supabase via schema.postgresql.prisma)
DATABASE_URL="file:./dev.db"
# Pour Supabase avec pooler PgBouncer (mode transaction :6543), renseignez aussi DIRECT_URL (:5432 pour prisma db push/migrate)
DIRECT_URL=""

# Serveur
PORT=4000
TRUST_PROXY_HOPS=0
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Authentification JWT — À CHANGER en production (chaîne longue et aléatoire)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Google Sign-In : ID client OAuth Web (Google Cloud Console > Identifiants > ID client OAuth 2.0 > Application Web).
# Ajoutez http://localhost:3000 dans « Origines JavaScript autorisées ».
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mobile Money : manual_reconciliation ou live
PAYMENT_WEBHOOK_SECRET=""
MOBILE_MONEY_MODE="manual_reconciliation"
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_API_URL=""
MOOV_MONEY_API_KEY=""
MOOV_MONEY_API_URL=""

# Notifications externes (E-mail Resend/SMTP webhook & SMS +235)
RESEND_API_KEY=""
EMAIL_FROM="PharmaConnect <notifications@pharmaconnect.td>"
SMTP_WEBHOOK_URL=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PharmaConn"

# Comptes de démonstration locaux
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL="admin@pharmaconnect.org"
SEED_ADMIN_PASSWORD="admin2026"
SEED_PHARMACY_PASSWORD="pharma2026"

# Dossier de stockage des fichiers téléversés
UPLOAD_DIR="./uploads"
