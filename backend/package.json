{
  "name": "pharmaconnect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST PharmaConnect (NestJS + Prisma + PostgreSQL) — KAYRA Innovation",
  "scripts": {
    "build": "nest build",
    "vercel-build": "node scripts/switch-db.mjs postgres && prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/security-and-business.test.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:use:sqlite": "node scripts/switch-db.mjs sqlite",
    "db:use:postgres": "node scripts/switch-db.mjs postgres",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "node --import tsx prisma/seed.ts",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run seed"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "prisma": "~6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
